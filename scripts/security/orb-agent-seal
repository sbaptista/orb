#!/bin/bash
#
# orb-agent-seal — seal the read-only agent database credential.
#
# HUMAN-RUN ONLY. Plan: docs/agent-capability-broker-plan.md
#
# Creates a SEPARATE encrypted store holding ONLY the orb_agent_ro
# connection fields, with its OWN passphrase — distinct from the master
# orb.env.enc passphrase. Compromising this store yields read access to
# the backlog and nothing else.
#
# Nothing is accepted as a command-line argument.

set -euo pipefail
set +x
umask 077

readonly SECRET_ROOT="/Users/stanleybaptista/Project-secrets"
readonly AGENT_DIR="$SECRET_ROOT/orb-agent"
readonly AGENT_FILE="$AGENT_DIR/agent.env.enc"
readonly OPENSSL="/opt/homebrew/bin/openssl"

fail() { printf 'orb-agent-seal: %s\n' "$*" >&2; exit 1; }

main() {
  [[ $# -eq 0 ]] || fail "usage: orb-agent-seal   (takes no arguments)"
  [[ -x "$OPENSSL" ]] || fail "OpenSSL is required at $OPENSSL"
  [[ -d "$SECRET_ROOT" ]] || fail "secret root is missing: $SECRET_ROOT"

  /bin/mkdir -p "$AGENT_DIR" "$AGENT_DIR/proposals"
  /bin/chmod 700 "$SECRET_ROOT" "$AGENT_DIR" "$AGENT_DIR/proposals"

  if [[ -e "$AGENT_FILE" ]]; then
    printf 'An agent credential store already exists at:\n  %s\n' "$AGENT_FILE"
    printf 'Resealing replaces it. Type yes to continue: '
    local answer=""; IFS= read -r answer
    [[ "$answer" == "yes" ]] || fail "aborted"
  fi

  printf '\nEnter the orb_agent_ro connection fields.\n'
  printf 'These come from the Supabase connection string for the READ-ONLY role\n'
  printf 'created by scripts/migrations/20260819_orb_agent_ro_role.sql.\n'
  printf 'Do NOT enter the master postgres credential here.\n\n'

  local host="" port="" database="" user="" password=""
  IFS= read -r -p "PGHOST     (e.g. db.<ref>.supabase.co): " host
  IFS= read -r -p "PGPORT     (5432 direct, 6543 pooler): " port
  IFS= read -r -p "PGDATABASE (usually postgres): " database
  IFS= read -r -p "PGUSER     (orb_agent_ro, or orb_agent_ro.<ref> via pooler): " user
  IFS= read -r -s -p "PGPASSWORD (not echoed): " password; printf '\n'

  [[ -n "$host" && -n "$port" && -n "$database" && -n "$user" && -n "$password" ]] \
    || fail "every field is required"
  [[ "$port" =~ ^[0-9]{2,5}$ ]] || fail "port must be numeric"
  [[ "$host" =~ ^[A-Za-z0-9.-]+$ ]] || fail "host contains unsupported characters"
  [[ "$user" =~ ^[A-Za-z0-9_.]+$ ]] || fail "user contains unsupported characters"
  [[ "$database" =~ ^[A-Za-z0-9_-]+$ ]] || fail "database contains unsupported characters"

  case "$user" in
    postgres|postgres.*|supabase_admin|service_role)
      fail "refusing to seal a privileged role ($user). This store is for orb_agent_ro only." ;;
  esac
  if [[ "$user" != orb_agent_ro && "$user" != orb_agent_ro.* ]]; then
    printf '\nWarning: user "%s" is not orb_agent_ro. Type yes to seal it anyway: ' "$user"
    local confirm=""; IFS= read -r confirm
    [[ "$confirm" == "yes" ]] || fail "aborted"
  fi

  local tmp=""
  tmp="$(/usr/bin/mktemp "$AGENT_DIR/agent.env.enc.tmp.XXXXXX")"
  trap '/bin/rm -f "$tmp"; unset password' EXIT

  printf '\norb-agent-seal: choose the AGENT passphrase.\n'
  printf 'Use a DIFFERENT passphrase from the master orb.env.enc store.\n'
  printf 'PGHOST=%s\nPGPORT=%s\nPGDATABASE=%s\nPGUSER=%s\nPGPASSWORD=%s\n' \
    "$host" "$port" "$database" "$user" "$password" \
    | "$OPENSSL" enc -aes-256-cbc -pbkdf2 -iter 210000 -salt -out "$tmp"

  printf 'orb-agent-seal: re-enter the agent passphrase to verify.\n'
  "$OPENSSL" enc -d -aes-256-cbc -pbkdf2 -iter 210000 -in "$tmp" -out /dev/null \
    || fail "verification failed — the store was NOT replaced"

  /bin/mv "$tmp" "$AGENT_FILE"
  /bin/chmod 600 "$AGENT_FILE"
  unset password
  trap - EXIT

  printf '\nSealed and verified:\n  %s\n\n' "$AGENT_FILE"
  printf 'Next: orb-agent-session --hours 8\n'
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
