#!/bin/bash

set -euo pipefail
set +x
umask 077

readonly secret_root="/Users/stanleybaptista/Project-secrets"
readonly secret_dir="$secret_root/orb-secrets"
readonly encrypted_file="$secret_dir/orb.env.enc"

allowed_names=(
  NEXT_PUBLIC_SUPABASE_URL
  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
  NEXT_PUBLIC_VAPID_PUBLIC_KEY
  ORB_API_ENABLED
  SUPABASE_SECRET_KEY
  DATABASE_URL
  ANTHROPIC_API_KEY
  ANTHROPIC_ADMIN_API_KEY
  ORB_API_SECRET
  RESEND_API_KEY
  VAPID_PRIVATE_KEY
  GEMINI_API_KEY
  GOOGLE_BILLING_CREDENTIALS_JSON_BASE64
  MISTRAL_API_KEY
  MOONSHOT_API_KEY
  OPENAI_API_KEY
  OPENAI_ADMIN_API_KEY
)

removable_names=(
  ELEVENLABS_API_KEY
)

fail() {
  printf 'orb-secrets-set: %s\n' "$*" >&2
  exit 1
}

is_allowed_name() {
  local candidate="$1"
  local allowed=""
  for allowed in "${allowed_names[@]}"; do
    [[ "$candidate" == "$allowed" ]] && return 0
  done
  return 1
}

is_removable_name() {
  local candidate="$1"
  local removable=""
  for removable in "${removable_names[@]}"; do
    [[ "$candidate" == "$removable" ]] && return 0
  done
  return 1
}

replace_value() {
  local target="$1"
  local replacement="$2"
  local line=""
  local name=""
  local found=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" || "$line" == \#* ]]; then
      printf '%s\n' "$line"
      continue
    fi
    [[ "$line" == *=* ]] || return 1
    name="${line%%=*}"
    if [[ "$name" == "$target" ]]; then
      printf '%s=%s\n' "$target" "$replacement"
      found=1
    else
      printf '%s\n' "$line"
    fi
  done

  if (( found == 0 )); then
    printf '%s=%s\n' "$target" "$replacement"
  fi
}

remove_value() {
  local target="$1"
  local line=""
  local name=""
  local found=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" || "$line" == \#* ]]; then
      printf '%s\n' "$line"
      continue
    fi
    [[ "$line" == *=* ]] || return 1
    name="${line%%=*}"
    if [[ "$name" == "$target" ]]; then
      found=1
    else
      printf '%s\n' "$line"
    fi
  done

  (( found == 1 ))
}

main() {
  local target=""
  local remove=0
  local passphrase=""
  local replacement=""
  local encrypted_tmp=""

  case "$#:${1:-}" in
    1:*) target="$1" ;;
    2:--remove) target="$2"; remove=1 ;;
    *) fail "usage: orb-secrets-set VARIABLE_NAME | orb-secrets-set --remove VARIABLE_NAME" ;;
  esac
  if (( remove == 1 )); then
    is_removable_name "$target" || fail "environment name cannot be removed: $target"
  else
    is_allowed_name "$target" || fail "unsupported environment name: $target"
  fi
  [[ -f "$encrypted_file" && ! -L "$encrypted_file" ]] || fail "encrypted environment is missing"
  [[ "$(/usr/bin/stat -f '%Lp' "$secret_root")" == "700" ]] || fail "secret root must have mode 700"
  [[ "$(/usr/bin/stat -f '%Lp' "$secret_dir")" == "700" ]] || fail "Orb secret directory must have mode 700"
  [[ "$(/usr/bin/stat -f '%Lp' "$encrypted_file")" == "600" ]] || fail "encrypted environment must have mode 600"

  IFS= read -r -s -p "Encrypted environment passphrase: " passphrase
  printf '\n'
  [[ -n "$passphrase" ]] || fail "passphrase cannot be empty"
  if (( remove == 0 )); then
    IFS= read -r -s -p "New value for $target: " replacement
    printf '\n'
    [[ -n "$replacement" ]] || fail "replacement cannot be empty"
  fi

  export ORB_SECRET_PASSPHRASE="$passphrase"
  encrypted_tmp="$(/usr/bin/mktemp "$secret_dir/orb.env.enc.tmp.XXXXXX")"
  trap '/bin/rm -f "$encrypted_tmp"; unset ORB_SECRET_PASSPHRASE' EXIT

  if (( remove == 1 )); then
    /opt/homebrew/bin/openssl enc -d -aes-256-cbc -pbkdf2 -iter 210000 \
      -pass env:ORB_SECRET_PASSPHRASE -in "$encrypted_file" \
      | remove_value "$target" \
      | /opt/homebrew/bin/openssl enc -aes-256-cbc -pbkdf2 -iter 210000 -salt \
          -pass env:ORB_SECRET_PASSPHRASE -out "$encrypted_tmp"
  else
    /opt/homebrew/bin/openssl enc -d -aes-256-cbc -pbkdf2 -iter 210000 \
      -pass env:ORB_SECRET_PASSPHRASE -in "$encrypted_file" \
      | replace_value "$target" "$replacement" \
      | /opt/homebrew/bin/openssl enc -aes-256-cbc -pbkdf2 -iter 210000 -salt \
          -pass env:ORB_SECRET_PASSPHRASE -out "$encrypted_tmp"
  fi

  /opt/homebrew/bin/openssl enc -d -aes-256-cbc -pbkdf2 -iter 210000 \
    -pass env:ORB_SECRET_PASSPHRASE -in "$encrypted_tmp" -out /dev/null

  /bin/mv "$encrypted_tmp" "$encrypted_file"
  /bin/chmod 600 "$encrypted_file"
  unset ORB_SECRET_PASSPHRASE passphrase replacement
  trap - EXIT

  if (( remove == 1 )); then
    printf 'Removed %s from the encrypted Orb environment.\n' "$target"
  else
    printf 'Updated %s in the encrypted Orb environment.\n' "$target"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
