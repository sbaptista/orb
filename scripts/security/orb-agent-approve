#!/bin/bash
#
# orb-agent-approve — review and apply one agent proposal.
#
# HUMAN-RUN ONLY. Plan: docs/agent-capability-broker-plan.md (Layer 2)
#
# This is the ONLY path by which agent-originated work reaches Orb's data.
# It unlocks the MASTER store, resolves the proposal against live records,
# prints the resolved target from trusted code (never the agent's own
# description of what it is doing — ORB-374 BP-3), and requires a typed
# confirmation.
#
# Writes go through the Orb REST API because `closed_at` is server-managed
# from `status`; a direct SQL UPDATE would silently skip it.

set -euo pipefail
set +x
umask 077

readonly SECRET_ROOT="/Users/stanleybaptista/Project-secrets"
readonly MASTER_FILE="$SECRET_ROOT/orb-secrets/orb.env.enc"
readonly AGENT_DIR="$SECRET_ROOT/orb-agent"
readonly PROPOSAL_DIR="$AGENT_DIR/proposals"
readonly AUDIT_FILE="$AGENT_DIR/audit.log"
readonly OPENSSL="/opt/homebrew/bin/openssl"
readonly ORB_BASE="https://orb-eight-lake.vercel.app"

fail() { printf 'orb-agent-approve: %s\n' "$*" >&2; exit 1; }

# Validate the COMPLETE proposal at apply time, not just at creation.
# Codex Round 2 R2-Q1: `orb-agent propose` was fixed to reject a closure with no
# Knowledge entry, but this script still accepted a stored proposal whose
# `knowledge` was null and marked it applied. A proposal written before that fix,
# or edited by any same-user process afterwards, produced the forbidden
# half-closure. Creation-time validation is not enforcement.
validate_proposal() {
  local path="$1"
  /usr/bin/python3 - "$path" <<'PY' || exit 1
import json, re, sys
p = json.load(open(sys.argv[1]))
errs = []
ATTR = re.compile(r'^\d{4}-\d{2}-\d{2} — .+ \(.+\)$')

if p.get("kind") != "todo-close":
    errs.append(f"unsupported kind: {p.get('kind')!r}")
if p.get("status") != "pending":
    errs.append(f"status is {p.get('status')!r}, expected 'pending'")
if not re.match(r'^[A-Za-z0-9_-]{1,16}-[0-9]{1,9}$', p.get("todo_ref") or ""):
    errs.append("todo_ref is missing or malformed")

notes = p.get("resolution_notes") or ""
if not notes.strip():
    errs.append("resolution_notes is empty")
elif not ATTR.match(notes.splitlines()[0]):
    errs.append("resolution_notes must begin with 'YYYY-MM-DD — Tool (Model)'")

k = p.get("knowledge")
if not k:
    errs.append("knowledge entry is MISSING — working rule 8 requires resolution "
                "notes AND a Knowledge entry, always both")
else:
    if not (k.get("title") or "").strip():
        errs.append("knowledge.title is empty")
    content = k.get("content") or ""
    if not content.strip():
        errs.append("knowledge.content is empty")
    elif not ATTR.match(content.splitlines()[0]):
        errs.append("knowledge.content must begin with 'YYYY-MM-DD — Tool (Model)'")
    if not isinstance(k.get("tags"), list):
        errs.append("knowledge.tags must be a list")

if errs:
    print("orb-agent-approve: proposal is INVALID and will not be applied:", file=sys.stderr)
    for e in errs:
        print(f"  - {e}", file=sys.stderr)
    sys.exit(1)
PY
}

# Hash the proposal so the bytes confirmed are the bytes applied. Between the
# banner and the typed "yes", any same-user process can rewrite the file.
proposal_hash() { /sbin/md5 -q "$1" 2>/dev/null || /usr/bin/shasum -a 256 "$1" | cut -d' ' -f1; }

audit() {
  printf '%s  %s\n' "$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >> "$AUDIT_FILE"
  /bin/chmod 600 "$AUDIT_FILE" 2>/dev/null || true
}

# curl with the credential supplied through --config on stdin, so it never
# enters argv and cannot be seen in `ps` or a shell history.
curl_auth() {
  local secret="$1"; shift
  printf 'header = "Authorization: %s"\n' "$secret" \
    | /usr/bin/curl --config - --silent --show-error --max-time 30 "$@"
}

curl_supabase() {
  local key="$1"; shift
  printf 'header = "apikey: %s"\nheader = "Authorization: Bearer %s"\n' "$key" "$key" \
    | /usr/bin/curl --config - --silent --show-error --max-time 30 "$@"
}

load_master() {
  local line="" name="" value="" decrypted="" parsed=0
  [[ -f "$MASTER_FILE" && ! -L "$MASTER_FILE" ]] || fail "master store is missing: $MASTER_FILE"
  [[ "$(/usr/bin/stat -f '%Lp' "$MASTER_FILE")" == "600" ]] || fail "master store must have mode 600"

  printf 'orb-agent-approve: unlock the MASTER Orb environment.\n'

  # COMMAND substitution, not process substitution: only the former propagates
  # the decrypt's exit status. See the long note in scripts/security/orb-dev —
  # R4-N1 established that a truncated store decrypts genuine plaintext for
  # every complete block before failing, so counting parsed lines authenticates
  # nothing. It matters more here than in orb-dev, because this runs at the
  # moment a mutation is being approved.
  if ! decrypted="$("$OPENSSL" enc -d -aes-256-cbc -pbkdf2 -iter 210000 -in "$MASTER_FILE")"; then
    fail "could not decrypt the master store — NOTHING WAS APPLIED.
Usually a wrong passphrase; openssl prints its own 'bad decrypt' above when so.
It also fires if the store is truncated or corrupt, in which case a partial
decrypt may have succeeded and is being discarded deliberately."
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || fail "master store contains a malformed line"
    name="${line%%=*}"; value="${line#*=}"
    parsed=$(( parsed + 1 ))
    case "$name" in
      ORB_API_SECRET|SUPABASE_SECRET_KEY|NEXT_PUBLIC_SUPABASE_URL)
        export "$name=$value" ;;
      *) : ;;   # every other credential is deliberately discarded
    esac
  done < <(printf '%s\n' "$decrypted")
  unset decrypted

  if (( parsed == 0 )); then
    fail "the master store decrypted but contained no assignments. NOTHING WAS APPLIED."
  fi

  [[ -n "${ORB_API_SECRET:-}" ]] || fail "master store did not yield ORB_API_SECRET"
  [[ -n "${SUPABASE_SECRET_KEY:-}" ]] || fail "master store did not yield SUPABASE_SECRET_KEY"
  [[ -n "${NEXT_PUBLIC_SUPABASE_URL:-}" ]] || fail "master store did not yield NEXT_PUBLIC_SUPABASE_URL"
}

main() {
  [[ $# -eq 1 ]] || fail "usage: orb-agent-approve <proposal-id>"
  local id="$1"
  [[ "$id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$ ]] || fail "invalid proposal id"

  local path="$PROPOSAL_DIR/$id.json"
  [[ -f "$path" ]] || fail "no such proposal: $id"

  local kind status ref
  kind="$(/usr/bin/python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["kind"])' "$path")"
  status="$(/usr/bin/python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["status"])' "$path")"
  ref="$(/usr/bin/python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["todo_ref"])' "$path")"

  [[ "$status" == "pending" ]] || fail "proposal $id is already '$status'"
  [[ "$kind" == "todo-close" ]] || fail "unsupported proposal kind: $kind"

  validate_proposal "$path" || fail "refusing to apply an invalid proposal"
  local hash_at_display
  hash_at_display="$(proposal_hash "$path")"

  local code="${ref%-*}" number="${ref##*-}"

  load_master

  # ---- Resolve the LIVE record. The banner below is built from this
  # ---- response, not from anything the agent wrote.
  printf '\nResolving %s against production...\n' "$ref"
  local todo_json
  todo_json="$(curl_auth "$ORB_API_SECRET" "$ORB_BASE/api/tasks?product=$code" \
    | /usr/bin/python3 -c "
import sys, json
tasks = json.load(sys.stdin)
match = [t for t in tasks if t.get('todo_number') == int('$number')]
print(json.dumps(match[0]) if match else '')")"

  [[ -n "$todo_json" ]] || fail "$ref was not found in production — nothing applied"

  local todo_id todo_title todo_status
  todo_id="$(/usr/bin/python3 -c 'import json,sys;print(json.loads(sys.argv[1])["id"])' "$todo_json")"
  todo_title="$(/usr/bin/python3 -c 'import json,sys;print(json.loads(sys.argv[1])["title"])' "$todo_json")"
  todo_status="$(/usr/bin/python3 -c 'import json,sys;print(json.loads(sys.argv[1])["status"])' "$todo_json")"

  local k_title k_tags notes_head
  k_title="$(/usr/bin/python3 -c '
import json,sys
k=json.load(open(sys.argv[1])).get("knowledge")
print(k["title"] if k else "(NONE — violates working rule 8)")' "$path")"
  k_tags="$(/usr/bin/python3 -c '
import json,sys
k=json.load(open(sys.argv[1])).get("knowledge")
print(",".join(k["tags"]) if k and k["tags"] else "(none)")' "$path")"
  notes_head="$(/usr/bin/python3 -c '
import json,sys
print(json.load(open(sys.argv[1]))["resolution_notes"].splitlines()[0])' "$path")"

  cat <<BANNER

────────────────────────────────────────────────────────────
  ENVIRONMENT   production ($ORB_BASE)
  ACTION        close todo + create Knowledge entry
  TODO          $ref  ($todo_id)
  TITLE         $todo_title
  STATUS        $todo_status  ->  closed
  NOTES (1st)   $notes_head
  KNOWLEDGE     $k_title
  TAGS          $k_tags
  PROPOSAL      $id
────────────────────────────────────────────────────────────

BANNER

  printf 'Apply this? Type exactly: yes\n> '
  local answer=""; IFS= read -r answer
  [[ "$answer" == "yes" ]] || { printf 'Aborted. Nothing was written.\n'; audit "proposal $id declined"; exit 1; }

  # The bytes you confirmed must be the bytes applied.
  if [[ "$(proposal_hash "$path")" != "$hash_at_display" ]]; then
    audit "proposal $id CHANGED between display and confirmation — refused"
    fail "the proposal file changed after it was displayed. Nothing applied.
Something rewrote $path between the banner and your confirmation."
  fi
  validate_proposal "$path" || fail "proposal became invalid after confirmation — nothing applied"

  # ---- ORDERING (Codex Round 2 R2-Q1): Knowledge FIRST, then close.
  #
  # The previous order closed the todo first. A failed Knowledge write then left
  # a closed todo with no Knowledge entry — a silent violation of working rule 8,
  # and the exact state the rule exists to prevent.
  #
  # Reversing the order cannot make the pair atomic, but it changes which
  # half-state is possible:
  #   old worst case: todo closed, no Knowledge   -> rule broken, looks complete
  #   new worst case: Knowledge written, todo open -> rule intact, visibly unfinished
  # The second is recoverable and obvious. That is the whole gain; it is not a
  # transaction and is not claimed as one.

  local product_id knowledge_body knowledge_result knowledge_id
  product_id="$(/usr/bin/python3 -c 'import json,sys;print(json.loads(sys.argv[1]).get("product_id") or "")' "$todo_json")"

  printf '\nWriting the Knowledge entry first...\n'
  knowledge_body="$(/usr/bin/python3 -c '
import json,sys
k=json.load(open(sys.argv[1]))["knowledge"]
print(json.dumps({
  "title": k["title"], "content": k["content"], "tags": k["tags"],
  "product_id": sys.argv[2] or None, "origin_todo_id": sys.argv[3],
}))' "$path" "$product_id" "$todo_id")"

  knowledge_result="$(printf '%s' "$knowledge_body" \
    | curl_supabase "$SUPABASE_SECRET_KEY" -X POST "$NEXT_PUBLIC_SUPABASE_URL/rest/v1/knowledge_repo" \
        -H "Content-Type: application/json" -H "Prefer: return=representation" --data-binary @-)"

  knowledge_id="$(printf '%s' "$knowledge_result" | /usr/bin/python3 -c '
import json,sys
try:
    d=json.load(sys.stdin); print(d[0]["id"] if isinstance(d,list) and d else "")
except Exception: print("")')"

  [[ -n "$knowledge_id" ]] || {
    audit "proposal $id FAILED at knowledge write — todo NOT closed"
    fail "the Knowledge write could not be confirmed. The todo is UNCHANGED and still open.
Response: $knowledge_result"
  }
  printf 'Knowledge entry created and verified: %s\n' "$knowledge_id"

  # ---- Now close the todo. closed_at is server-managed from status, which is
  # why this goes through the REST API rather than a direct UPDATE.
  printf 'Closing %s...\n' "$ref"
  local patch_body patch_result new_status
  patch_body="$(/usr/bin/python3 -c '
import json,sys
p=json.load(open(sys.argv[1]))
print(json.dumps({"status":"closed","resolution_notes":p["resolution_notes"]}))' "$path")"

  patch_result="$(printf '%s' "$patch_body" \
    | curl_auth "$ORB_API_SECRET" -X PATCH "$ORB_BASE/api/tasks/$todo_id" \
        -H "Content-Type: application/json" --data-binary @-)"

  new_status="$(printf '%s' "$patch_result" | /usr/bin/python3 -c '
import json,sys
try:
    d=json.load(sys.stdin); print((d.get("task") or d).get("status",""))
except Exception: print("")')"

  if [[ "$new_status" != "closed" ]]; then
    audit "proposal $id PARTIAL — knowledge $knowledge_id written, todo NOT closed"
    /usr/bin/python3 -c '
import json,sys
p=json.load(open(sys.argv[1])); p["status"]="partial"; p["knowledge_id"]=sys.argv[2]
open(sys.argv[1],"w").write(json.dumps(p,indent=2))' "$path" "$knowledge_id"
    fail "the Knowledge entry WAS written ($knowledge_id) but the todo did NOT close
(response said: ${new_status:-<unparseable>}).
The todo is still open, which is the recoverable half-state. Re-running would
duplicate the Knowledge entry — close the todo manually, or delete $knowledge_id first."
  fi
  printf 'Todo closed and verified.\n'

  /usr/bin/python3 -c '
import json,sys,datetime
p=json.load(open(sys.argv[1]))
p["status"]="applied"
p["applied_at"]=datetime.datetime.now(datetime.timezone.utc).isoformat()
open(sys.argv[1],"w").write(json.dumps(p,indent=2))' "$path"

  audit "proposal $id applied — $ref closed"
  printf '\nProposal %s applied.\n' "$id"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
