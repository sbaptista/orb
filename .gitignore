# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.orb-source/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# other AI tools
opencode.json

# session files
_sessions/

# claude
# Ignore everything under .claude/ (session data, memory, personal
# settings.local.json) EXCEPT settings.json — the tracked project permission
# rules that enforce the push gate. See shared AGENTS.md "Git — Commits and
# Pushes". Note: `.claude/*` (not `.claude/`) is required, because git cannot
# re-include a file whose parent directory is itself excluded.
.claude/*
!.claude/settings.json
